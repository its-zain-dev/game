        send_all(&g, &Arc::new(ws_frame(2, &b)));
    }
    drop(tx);
    let _ = s.shutdown(Shutdown::Both);
    res
}

fn send_all(g: &World, f: &Frame) {
    for p in g.players.values() {
        if p.joined() { let _ = p.tx.try_send(f.clone()); }
    }
}

