      zx /= l; zy /= l; zz /= l;
      let (mut xx, xy, mut xz) = (zz, 0.0f32, -zx);
      let l = (xx * xx + xz * xz).sqrt().max(1e-6);
      xx /= l; xz /= l;
      let (yx, yy, yz) = (zy * xz - zz * xy, zz * xx - zx * xz, zx * xy - zy * xx);
