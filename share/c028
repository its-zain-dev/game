      let _ = l.root.style().set_property("transform", &format!("translate3d({sx:.1}px,{sy:.1}px,0) translate(-50%,-100%)"));
  }

  fn expire(l: &mut Label, now: f64) {
      if l.bubble_until > 0.0 && now > l.bubble_until {
          l.bub.set_text_content(None);
          l.bubble_until = 0.0;
      }
  }

