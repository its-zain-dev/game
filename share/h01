#hud{position:fixed;top:8px;left:8px;font:12px monospace;color:#333;direction:ltr;pointer-events:none}
#chatlog{position:fixed;left:10px;bottom:60px;width:min(420px,70vw);display:flex;flex-direction:column;gap:3px;pointer-events:none}
#chatlog div{background:rgba(0,0,0,.4);color:#fff;font-size:13px;padding:3px 8px;border-radius:6px;align-self:flex-start;max-width:100%;overflow-wrap:anywhere}
#chatin{position:fixed;left:10px;bottom:12px;width:min(420px,80vw);display:none;font-size:16px;padding:8px 12px;border-radius:8px;border:0;outline:2px solid #222}
#ui{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.55)}
.card{background:#fff;padding:24px 32px;border-radius:14px;box-shadow:0 6px 30px rgba(0,0,0,.15);text-align:center;display:flex;flex-direction:column;gap:12px;min-width:260px}
#name{font-size:17px;padding:10px;border-radius:8px;border:1px solid #ccc;text-align:center}
.row{display:flex;align-items:center;justify-content:center;gap:12px}
input[type=color]{width:70px;height:44px;border:0;background:none;cursor:pointer}
#go{font-size:18px;padding:12px;border:0;border-radius:8px;background:#222;color:#fff;cursor:pointer}
.tip{margin:0;font-size:12px;color:#777}
