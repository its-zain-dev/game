#help{position:fixed;bottom:8px;right:8px;font-size:12px;color:#555;pointer-events:none}
#tc{display:none}
body[data-touch] #tc{display:block}
body[data-touch] #help{display:none}
#joy{position:fixed;left:0;top:0;width:120px;height:120px;margin:-60px 0 0 -60px;border-radius:50%;background:rgba(0,0,0,.12);border:2px solid rgba(0,0,0,.2);display:none;pointer-events:none}
#knob{position:absolute;left:33px;top:33px;width:50px;height:50px;border-radius:50%;background:rgba(0,0,0,.35)}
#jump,#chatbtn{position:fixed;border:0;border-radius:50%;background:rgba(0,0,0,.25);color:#fff;touch-action:none}
#jump{right:calc(24px + env(safe-area-inset-right));bottom:calc(30px + env(safe-area-inset-bottom));width:80px;height:80px;font-size:34px}
#chatbtn{right:calc(120px + env(safe-area-inset-right));bottom:calc(40px + env(safe-area-inset-bottom));width:56px;height:56px;font-size:24px}
</style>
</head>
<body>
<canvas id="c"></canvas>
<div id="labels"></div>
<div id="hud">Loading...</div>
<div id="chatlog"></div>
<input id="chatin" maxlength="100" placeholder="اكتب رسالة... Enter للإرسال" autocomplete="off">
<div id="tc"><div id="joy"><div id="knob"></div></div><button id="jump">⤒</button><button id="chatbtn">💬</button></div>
