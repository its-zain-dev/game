#ui{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.55)}
.card{background:#fff;padding:24px 32px;border-radius:14px;box-shadow:0 6px 30px rgba(0,0,0,.15);text-align:center;display:flex;flex-direction:column;gap:12px;min-width:260px}
#name{font-size:17px;padding:10px;border-radius:8px;border:1px solid #ccc;text-align:center}
.row{display:flex;align-items:center;justify-content:center;gap:12px}
input[type=color]{width:70px;height:44px;border:0;background:none;cursor:pointer}
